<mxfile host="app.diagrams.net"><diagram name="Ubuntu boot process" id="week03-boot"><mxGraphModel page="1" pageWidth="1000" pageHeight="1530"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Ubuntu Server Boot Process&#10;Jaymark Viriña | ITEP 414 | Week 3" style="text;html=0;align=center;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="22" width="820" height="110" /></mxCell><mxCell id="stage-0" value="1. Power On&#10;The VM receives virtual power; the processor starts firmware." style="rounded=1;arcSize=100;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=23;fillColor=#f1f5f8;strokeColor=#1b465f;" vertex="1" parent="1"><mxGeometry as="geometry" x="105" y="176" width="790" height="112" /></mxCell><mxCell id="stage-1" value="2. BIOS / UEFI Initialization&#10;Firmware initializes hardware and performs startup checks." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=23;fillColor=#f1f5f8;strokeColor=#1b465f;" vertex="1" parent="1"><mxGeometry as="geometry" x="105" y="327" width="790" height="112" /></mxCell><mxCell id="edge-1" edge="1" parent="1" source="stage-0" target="stage-1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#397a85;strokeWidth=3;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="stage-2" value="3. Boot Device Detection&#10;Firmware selects a boot entry or bootable device." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=23;fillColor=#f1f5f8;strokeColor=#1b465f;" vertex="1" parent="1"><mxGeometry as="geometry" x="105" y="478" width="790" height="112" /></mxCell><mxCell id="edge-2" edge="1" parent="1" source="stage-1" target="stage-2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#397a85;strokeWidth=3;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="stage-3" value="4. Boot Loader - GRUB&#10;GRUB selects Linux and loads the kernel and initramfs." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=23;fillColor=#f1f5f8;strokeColor=#1b465f;" vertex="1" parent="1"><mxGeometry as="geometry" x="105" y="629" width="790" height="112" /></mxCell><mxCell id="edge-3" edge="1" parent="1" source="stage-2" target="stage-3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#397a85;strokeWidth=3;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="stage-4" value="5. Linux Kernel&#10;Kernel initializes devices; initramfs helps mount the root filesystem." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=23;fillColor=#f1f5f8;strokeColor=#1b465f;" vertex="1" parent="1"><mxGeometry as="geometry" x="105" y="780" width="790" height="112" /></mxCell><mxCell id="edge-4" edge="1" parent="1" source="stage-3" target="stage-4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#397a85;strokeWidth=3;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="stage-5" value="6. init / systemd&#10;systemd runs as PID 1 and organizes userspace startup." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=23;fillColor=#f1f5f8;strokeColor=#1b465f;" vertex="1" parent="1"><mxGeometry as="geometry" x="105" y="931" width="790" height="112" /></mxCell><mxCell id="edge-5" edge="1" parent="1" source="stage-4" target="stage-5" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#397a85;strokeWidth=3;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="stage-6" value="7. Services Start&#10;Configured services and login-related targets start." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=23;fillColor=#f1f5f8;strokeColor=#1b465f;" vertex="1" parent="1"><mxGeometry as="geometry" x="105" y="1082" width="790" height="112" /></mxCell><mxCell id="edge-6" edge="1" parent="1" source="stage-5" target="stage-6" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#397a85;strokeWidth=3;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="stage-7" value="8. Login Prompt&#10;The console accepts a user login; SSH is available when configured." style="rounded=1;arcSize=100;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=23;fillColor=#f1f5f8;strokeColor=#1b465f;" vertex="1" parent="1"><mxGeometry as="geometry" x="105" y="1233" width="790" height="112" /></mxCell><mxCell id="edge-7" edge="1" parent="1" source="stage-6" target="stage-7" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#397a85;strokeWidth=3;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="notes" value="UEFI may load shim before GRUB when using Secure Boot.&#10;Legacy BIOS reaches GRUB through its disk boot code.&#10;Sources: GNU GRUB Manual; systemd bootup." style="text;html=0;align=center;fontSize=20;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1403" width="900" height="110" /></mxCell></root></mxGraphModel></diagram></mxfile>